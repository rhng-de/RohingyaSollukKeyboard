c Type all Rohingya scripts with the same layout!
c 
c For more information on Rohingya script development visit https://rhng.de
store(&VERSION) '15.0'
store(&TARGETS) 'any windows macosx linux web iphone ipad androidphone androidtablet mobile desktop tablet'
store(&COPYRIGHT) 'CC-BY-4.0 rhng.de'
store(&KMW_RTL) '1'
store(&MESSAGE) 'One keyboard layout for all Rohingya scripts'
store(&KMW_HELPTEXT) 'https://www.rhng.de/keyboard'
store(&BITMAP) 'rohingya_solluk_hanifi.ico'
store(&VISUALKEYBOARD) 'rohingya_solluk_hanifi.kvks'
store(&NAME) 'Rohingya Solluk Hanifi'
store(&KEYBOARDVERSION) '1.1.25'
store(&LAYOUTFILE) 'rohingya_solluk_hanifi.keyman-touch-layout'
begin Unicode > use(main)

group(main) using keys
store(consonants_vowels_glides_tones) U+10D24 U+10D25 U+10D26 U+10D17 U+10D1 U+10D1D U+10D1E U+10D1F U+10D20 U+10D21 U+10D00 U+10D01 U+10D02 U+10D03 U+10D04 U+10D05 U+10D06 U+10D07 U+10D08 U+10D09 U+10D0A U+10D0B U+10D0C U+10D0D U+10D0E U+10D0F U+10D10 U+10D11 U+10D12 U+10D13 U+10D14 U+10D15 U+10D16 U+10D18 U+10D1A U+10D1B U+10D1C
store(tonebase) U+10D1D U+10D1E U+10D1F U+10D20 U+10D21
store(tone) U+10D24 U+10D25 U+10D26
store(tassibase) U+10D01 U+10D02 U+10D03 U+10D04 U+10D05 U+10D06 U+10D09 U+10D03 U+10D0B U+10D0C U+10D0E U+10D0F U+10D10 U+10D11 U+10D12 U+10D13 U+10D14 U+10D15 U+10D16 U+10D18 U+10D1C
store(tassi) U+10D27
store(vowel) U+10D1D U+10D1E U+10D1F U+10D20 U+10D21
store(consonant) U+10D27 U+10D00 U+10D01 U+10D02 U+10D03 U+10D04 U+10D05 U+10D06 U+10D07 U+10D08 U+10D09 U+10D0A U+10D0B U+10D0C U+10D0D U+10D0E U+10D0F U+10D10 U+10D11 U+10D12 U+10D13 U+10D14 U+10D15 U+10D16 U+10D18 U+10D1A U+10D1B U+10D1C
store(consonant_with_sakin) U+10D01 U+10D02 U+10D03 U+10D04 U+10D07 U+10D08 U+10D09 U+10D0A U+10D0E U+10D0F U+10D10 U+10D1C
c TODO store(consonant_with_tassi)
store(glide) U+10D17 U+10D1
store(separator)  U+000D U+000E U+000F U+0010 U+0011 U+0012 U+0013 U+0014 U+0015 U+0016 U+0017 U+0018 U+0019 U+0020 U+0021 U+0022 U+0028 U+0029 U+002C U+002D U+002E U+002F U+003A U+003C U+003E U+003F U+005B U+005C U+005D U+005F U+060C U+061B U+061F U+007B U+007C U+007D 

c TODO add Return Key to the ya/wa/sakin fixes

c main layers
c numbers
+ [K_0] > '𐴰'
+ [K_1] > '𐴱'
+ [K_2] > '𐴲'
+ [K_3] > '𐴳'
+ [K_4] > '𐴴'
+ [K_5] > '𐴵'
+ [K_6] > '𐴶'
+ [K_7] > '𐴷'
+ [K_8] > '𐴸'
+ [K_9] > '𐴹'
c vowels
+ [K_A] > U+10D1D
+ [SHIFT K_A] > U+10D00 U+10D1D
+ [K_I] > U+10D1E
+ [SHIFT K_I] > U+10D00 U+10D1E
+ [K_U] >  U+10D1F
+ [SHIFT K_U] >  U+10D00 U+10D1F
+ [K_E] >  U+10D20
+ [SHIFT K_E] >  U+10D00 U+10D20
+ [K_O] > U+10D21
+ [SHIFT K_O] > U+10D00 U+10D21
c tone marks
+ [K_LBRKT] > U+10D25
+ [K_BKSLASH] > U+10D26
+ [K_RBRKT] > U+10D24
c nasalizer
+ [SHIFT K_N] > '𐴣'
c sakin
+ [K_V] > U+10D22
c germination mark
+ [SHIFT K_V] > U+10D27
c glides
+ [SHIFT K_W] > '𐴗'
+ [SHIFT K_Y] > '𐴙'
c interpunctuation & special characters
+ [K_BKQUOTE] > '̀'
+ [K_COLON] > '؛'
+ [K_COMMA] > '،'
+ [K_EQUAL] > '='
+ [K_HYPHEN] > '-'
+ [K_PERIOD] > '.'
+ [K_QUOTE] > U+0027
+ [K_SLASH] > '/'
+ [SHIFT K_0] > ')'
+ [SHIFT K_1] > '!'
+ [SHIFT K_2] > '@'
+ [SHIFT K_3] > '#'
+ [SHIFT K_4] > '$'
+ [SHIFT K_5] > '%'
+ [SHIFT K_6] > U+0302
U+0302 + [K_SPACE] > U+005E
+ [SHIFT K_7] > '&'
+ [SHIFT K_8] > '*'
+ [SHIFT K_9] > '('
+ [SHIFT K_BKQUOTE] > '̃'
+ [SHIFT K_BKSLASH] > '\'
+ [SHIFT K_COLON] > ':'
+ [SHIFT K_COMMA] > '<'
+ [SHIFT K_EQUAL] > '+'
+ [SHIFT K_HYPHEN] > '_'
+ [SHIFT K_LBRKT] > '['
+ [SHIFT K_PERIOD] > '>'
+ [SHIFT K_QUOTE] > '”'
U+201D + [SHIFT K_QUOTE] > U+201C
+ [SHIFT K_RBRKT] > ']'
+ [SHIFT K_SLASH] > '؟'
c consonants
+ [K_Q] > U+10D00
+ [SHIFT K_Q] > U+10D1B
+ [K_B] > U+10D01
+ [SHIFT K_F] > U+10D1C
+ [K_C] > U+10D10
+ [SHIFT K_C] > U+10D06
+ [K_D] > U+10D0A
+ [SHIFT K_D] > U+10D0B
+ [K_F] > U+10D09
+ [K_G] > U+10D12
+ [SHIFT K_G] > U+10D1A
+ [K_H] > U+10D07
+ [SHIFT K_H] > U+10D08
+ [K_X] > U+10D08
+ [K_J] > U+10D05
+ [K_K] > U+10D11
+ [K_L] > U+10D13
+ [K_M] > U+10D14
+ [SHIFT K_M] > U+10D1A
+ [K_N] > U+10D15
+ [K_P] > U+10D02
+ [K_R] > U+10D0C
+ [SHIFT K_R] > U+10D0D
+ [K_S] > U+10D0F
+ [SHIFT K_S] > U+10D10
+ [K_T] > U+10D03
+ [SHIFT K_T] > U+10D04
+ [K_W] > U+10D16
+ [K_Y] > U+10D18
+ [K_Z] > U+10D0E

c Common fixes:
c Fix order kinna-ya.ya and na-khonna
U+10D19 + [SHIFT K_N] > U+10D23 U+10D19
U+10D18 + [SHIFT K_N] > U+10D23 U+10D19

c Fix missing sakin
any(consonant_with_sakin) + [K_SPACE] > context(1) U+10D22 U+0020
any(consonant_with_sakin) + [K_BKQUOTE] > context(1) U+10D22 '́'
any(consonant_with_sakin) + [K_COLON] > context(1) U+10D22 '؛'
any(consonant_with_sakin) + [K_COMMA] > context(1) U+10D22 '،'
any(consonant_with_sakin) + [K_EQUAL] > context(1) U+10D22 '='
any(consonant_with_sakin) + [K_HYPHEN] > context(1) U+10D22 '-'
any(consonant_with_sakin) + [K_PERIOD] > context(1) U+10D22 '.'
any(consonant_with_sakin) + [K_QUOTE] > context(1) U+10D22 U+0027
any(consonant_with_sakin) + [K_SLASH] > context(1) U+10D22 '/'
any(consonant_with_sakin) + [SHIFT K_0] > context(1) U+10D22 ')'
any(consonant_with_sakin) + [SHIFT K_1] > context(1) U+10D22 '!'
any(consonant_with_sakin) + [SHIFT K_2] > context(1) U+10D22 '@'
any(consonant_with_sakin) + [SHIFT K_3] > context(1) U+10D22 '#'
any(consonant_with_sakin) + [SHIFT K_4] > context(1) U+10D22 '$'
any(consonant_with_sakin) + [SHIFT K_5] > context(1) U+10D22 '%'
any(consonant_with_sakin) + [SHIFT K_6] > context(1) U+10D22 '^'
any(consonant_with_sakin) + [SHIFT K_7] > context(1) U+10D22 '&'
any(consonant_with_sakin) + [SHIFT K_8] > context(1) U+10D22 '*'
any(consonant_with_sakin) + [SHIFT K_9] > context(1) U+10D22 '('
any(consonant_with_sakin) + [SHIFT K_BKQUOTE] > context(1) U+10D22 '̃'
any(consonant_with_sakin) + [SHIFT K_BKSLASH] > context(1) U+10D22 '\'
any(consonant_with_sakin) + [SHIFT K_COLON] > context(1) U+10D22 ':'
any(consonant_with_sakin) + [SHIFT K_COMMA] > context(1) U+10D22 '<'
any(consonant_with_sakin) + [SHIFT K_EQUAL] > context(1) U+10D22 '+'
any(consonant_with_sakin) + [SHIFT K_HYPHEN] > context(1) U+10D22 '_'
any(consonant_with_sakin) + [SHIFT K_LBRKT] > context(1) U+10D22 '['
any(consonant_with_sakin) + [SHIFT K_PERIOD] > context(1) U+10D22 '>'
any(consonant_with_sakin) + [SHIFT K_QUOTE] > context(1) U+10D22 '”'

c delete Sakin if backspaced
any(consonant_with_sakin) U+10D22 + [K_BKSP] > context(1)

c Prohibit adding tones to non-vowels; disabled to enable typing broken modern Hanifi
c notany(vowel) + [K_LBRKT]  > context(1)
c notany(vowel) + [K_RBRKT] > context(1)
c notany(vowel) + [K_BKSLASH]  > context(1)
c Fix prematurely typed tone mark (overruled?)
c any(tone) + [K_A] > U+10D1D context(1)
c any(tone) + [K_I] > U+10D1E context(1)
c any(tone) + [K_U] > U+10D1F context(1)
c any(tone) + [K_E] > U+10D20 context(1)
c any(tone) + [K_O] > U+10D21 context(1)

c lazy germination
U+10D1B + [SHIFT K_Q] > U+10D1B U+10D27
U+10D01 + [K_B] > U+10D01 U+10D27
U+10D1C + [SHIFT K_F] > U+10D1C U+10D27
U+10D10 + [K_C] > U+10D10 U+10D27
U+10D06 + [SHIFT K_C] > U+10D06 U+10D27
U+10D0A + [K_D] > U+10D0A U+10D27
U+10D0B + [SHIFT K_D] > U+10D0B U+10D27
U+10D09 + [K_F] > U+10D09 U+10D27
U+10D12 + [K_G] > U+10D12 U+10D27
U+10D07 + [K_H] > U+10D07 U+10D27
U+10D08 + [K_X] > U+10D08 U+10D27
U+10D05 + [K_J] > U+10D05 U+10D27
U+10D11 + [K_K] > U+10D11 U+10D27
U+10D13 + [K_L] > U+10D13 U+10D27
U+10D14 + [K_M] > U+10D14 U+10D27
U+10D1A + [SHIFT K_M] > U+10D1A U+10D27
U+10D15 + [K_N] > U+10D15 U+10D27
U+10D02 + [K_P] > U+10D02 U+10D27
U+10D0C + [K_R] > U+10D0C U+10D27
U+10D0D + [SHIFT K_R] > U+10D0D U+10D27
U+10D0F + [K_S] > U+10D0F U+10D27
U+10D10 + [SHIFT K_S] > U+10D10 U+10D27
U+10D03 + [K_T] > U+10D03 U+10D27
U+10D04 + [SHIFT K_T] > U+10D04 U+10D27
U+10D16 + [K_W] > U+10D16 U+10D27
U+10D18 + [K_Y] > U+10D18 U+10D27
U+10D0E + [K_Z] > U+10D0E U+10D27

