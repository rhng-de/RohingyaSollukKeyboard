c Type all Rohingya scripts with the same layout!
c 
c For more information on Rohingya script development visit https://rhng.de
store(&VERSION) '15.0'
store(&COPYRIGHT) 'CC-BY-4.0 rhng.de'
store(&KMW_RTL) '1'
store(&KEYBOARDVERSION) '1.1.25'
store(&MESSAGE) 'One keyboard layout for all Rohingya scripts'
store(&KMW_HELPTEXT) 'https://www.rhng.de/keyboard'
store(&BITMAP) 'rohingya_solluk_fonna.ico'
store(&VISUALKEYBOARD) 'rohingya_solluk_fonna.kvks'
store(&NAME) 'Rohingya Solluk Fonna'
store(&TARGETS) 'any windows macosx linux web iphone ipad androidphone androidtablet mobile desktop tablet'
store(&LAYOUTFILE) 'rohingya_solluk_fonna.keyman-touch-layout'
begin Unicode > use(main)

group(main) using keys

c numbers
+ [K_0] > '۰'
+ [K_1] > '۱'
+ [K_2] > '۲'
+ [K_3] > '۳'
+ [K_4] > '۴'
+ [K_5] > '۵'
+ [K_6] > '۶'
+ [K_7] > '۷'
+ [K_8] > '۸'
+ [K_9] > '۹'

c tone marks
+ [K_LBRKT] > dk(tone_onedot)
+ [K_RBRKT] > dk(tone_twodot)
+ [K_BKSLASH] > dk(tone_twodot)

c killer (head of Khah)
+ [K_V] > 'ۡ'

c germination (shadda/tassi)
+ [SHIFT K_V] > 'ّ'

c vowels & tan-vowels
+ [K_A] > U+064E
U+064E + [K_A] > U+064B
+ [K_I] > U+0650
U+0650 + [K_I] > U+064D
+ [K_U] > 'ُ'
U+064F + [K_U] > U+08E8
+ [K_E] > U+08E6
U+08E6 + [K_E] > U+08E9
+ [K_O] > U+08E4
U+08E4 + [K_O] > U+08E7
+ [SHIFT K_O] > U+08E5
U+08E5 + [SHIFT K_O] > U+08E8

c glides
+ [SHIFT K_Y] > 'ࢬ'
+ [SHIFT K_W] > 'ࢫ'

c consonants
