    <GraphicFile>rhng_logo_portrait.png</GraphicFile>
    <MSIFileName></MSIFileName>
    <MSIOptions></MSIOptions>
  </Options>
  <StartMenu>
    <Folder></Folder>
    <Items/>
  </StartMenu>
  <Info>
    <Version URL="">0.8.0</Version>
    <Name URL="">Rohingya Solluk</Name>
    <Copyright URL="">CC-BY-4.0 rhng.de</Copyright>
    <Author URL="mailto:keyboard@rhng.de">Michael Schneider</Author>
    <WebSite URL="https://www.rhng.de">https://www.rhng.de</WebSite>
    <Description URL="">This mobile keyboard layout is still a beta. Flawless function is not guaranteed. Please provide feedback to keyboard@rhng.de about anny issues or improvements you would like to see implemented.</Description>
  </Info>
  <Files>
    <File>
      <Name>build\rohingya_solluk.kvk</Name>
      <Description>File rohingya_solluk.kvk</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.kvk</FileType>
    </File>
    <File>
      <Name>build\rohingya_solluk.kmx</Name>
      <Description>Keyboard Rohingya Solluk</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.kmx</FileType>
    </File>
    <File>
      <Name>rohingya_solluk.ico</Name>
      <Description>File rohingya_solluk.ico</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.ico</FileType>
    </File>
    <File>
      <Name>rohingya_solluk_regular.ttf</Name>
      <Description>Font Rohingya Solluk Regular</Description>
      <CopyLocation>0</CopyLocation>
