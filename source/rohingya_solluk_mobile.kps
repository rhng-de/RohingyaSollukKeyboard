    </File>
    <File>
      <Name>build\rohingya_solluk.js</Name>
      <Description>File rohingya_solluk.js</Description>
      <CopyLocation>0</CopyLocation>
      <FileType>.js</FileType>
    </File>
    <File>
      <Name>build\rohingya_solluk.kmp</Name>
