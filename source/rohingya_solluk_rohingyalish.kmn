c Type all Rohingya scripts with the same layout!
c 
c For more information on Rohingya script development visit https://rhng.de
store(&VERSION) '15.0'
store(&TARGETS) 'any windows macosx linux web iphone ipad androidphone androidtablet mobile desktop tablet'
store(&COPYRIGHT) 'CC-BY-4.0 rhng.de'
store(&KEYBOARDVERSION) '1.1.25'
store(&MESSAGE) 'One keyboard layout for all Rohingya scripts'
store(&KMW_HELPTEXT) 'https://www.rhng.de/keyboard'
store(&BITMAP) 'rohingya_solluk_rohingyalish.ico'
store(&VISUALKEYBOARD) 'rohingya_solluk_rohingyalish.kvks'
store(&NAME) 'Rohingya Solluk Rohingyalish'
store(&LAYOUTFILE) 'rohingya_solluk_rohingyalish.keyman-touch-layout'
begin Unicode > use(main)

group(main) using keys

store(vowel) 'AEIOUaeiou' U+034F
store(vowel_incl_nasal) 'AÃEẼIĨOÕUŨaãeẽiĩoõuũ' U+034F
store(every_vowel) 'AÃÁÀẪEẼÉÈỄIĨÍÌOÕÓÒỖṌUŨÚṸÙaãáàẫeẽéèễiĩíìoõóòỗṍuũúùṹ'
store(retroflex_base) 'DRTdrt'
store(fricative_base) 'Hh'
store(dot_below_base) 'DRTHdrth'

+ [K_0] > '0'
